# CryoZen UI — Environment Configuration
# Copy this file to .env and fill in your values.
#
# This file covers the settings most deployments touch. The complete list of
# every variable the code reads, with its real default and effect, lives in
# docs/reference/configuration.md.

# ============================================================
# LLM Configuration
# ============================================================

# Primary LLM host (default: localhost)
LLM_HOST=localhost

# Additional LLM hosts, comma-separated (for model discovery)
# Use hostnames/IPs only; CryoZen scans common serve ports, including Ollama's 11434.
# LLM_HOSTS=llm-host.local,backup-llm.local

# Optional Ollama base URL. In Docker, host Ollama is usually reachable here
# when started with OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional LM Studio URL. In Docker, host LM Studio is reachable here
# when LM Studio is set to serve on all interfaces (0.0.0.0).
# LM_STUDIO_URL=http://host.docker.internal:1234

# Hosted LLM provider keys. Each one is read at import by
# services/constants.py and unlocks that provider's models.
# Do not commit real keys. Keep these commented until needed.
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# PERPLEXITY_API_KEY=your_perplexity_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# TOGETHER_API_KEY=your_together_api_key_here
# FIREWORKS_API_KEY=your_fireworks_api_key_here
# XAI_API_KEY=your_xai_api_key_here

# Extra CA bundle for LLM providers whose TLS chain isn't in the default
# trust store. Layered ON TOP of the system / certifi bundle — verification
# stays on for every host, the trust set just gets larger. Useful for:
#   - GigaChat / Sber (Russian Trusted Root CA): without this the endpoint
#     shows offline with CERTIFICATE_VERIFY_FAILED — self-signed certificate
#     in certificate chain.
#   - On-premise / corporate LLM gateways with an internal CA.
# Point at a PEM file containing the missing root(s).
# LLM_CA_BUNDLE=/etc/cryozen/ca/extra-roots.pem

# ============================================================
# Search & Web
# ============================================================

# SearXNG instance URL (self-hosted, for web search).
# Docker Compose overrides this to http://searxng:8080 for in-network access.
SEARXNG_INSTANCE=http://localhost:8080

# Optional SearXNG cookie/CSRF secret. If blank, Docker generates one on first boot
# and stores it in the searxng-data volume.
# SEARXNG_SECRET=

# Third-party search provider keys. These are fallbacks only: a key saved in
# Settings -> Search, or in the integration credential store, wins over the
# environment. GOOGLE_API_KEY is shared with the LLM provider block above and
# needs GOOGLE_PSE_CX to address a Programmable Search engine.
# DATA_BRAVE_API_KEY=your_brave_api_key_here
# GOOGLE_PSE_CX=your_google_pse_engine_id_here
# TAVILY_API_KEY=your_tavily_api_key_here
# SERPER_API_KEY=your_serper_api_key_here

# Engines SearXNG queries for general (non-news) searches. The upstream
# defaults are routinely rate-limited and return nothing on a self-hosted
# instance, so this pinned list is the default.
# SEARXNG_GENERAL_ENGINES=bing,mojeek,presearch

# ============================================================
# Database
# ============================================================

# SQLAlchemy connection URL.
# Default: sqlite:///{DATA_DIR}/smriti.db, where DATA_DIR is the resolved vault
# path from services/constants.py (~/.cryozen unless CRYOZEN_DATA_DIR is set),
# NOT the repository ./data directory.
# DATABASE_URL=sqlite:////home/you/.cryozen/smriti.db

# Vault directory holding sessions, memory, uploads, settings, and the SQLite
# database. Overrides ~/.cryozen_vault_config.json. Docker Compose pins this to
# /app/data so writes land in the bind mount instead of an unmounted home dir.
# CRYOZEN_DATA_DIR=/home/you/.cryozen

# ============================================================
# Auth & Security
# ============================================================

# Signing key for the Starlette session cookie, which carries in-flight OAuth
# state. READ THIS BEFORE DEPLOYING.
# When unset, cryozen.py falls back to secrets.token_urlsafe(32), evaluated once
# per process, so the key is NEW on every boot and differs between workers. Any
# provider sign-in still in flight across a restart, crash-loop, or recreate
# fails, and it cannot work at all across more than one worker or replica,
# because the process that finishes the exchange cannot read the state the
# process that started it signed.
# Login sessions themselves are not affected: they persist server-side in
# data/sessions.json and survive restarts regardless of this value.
# Set it for any multi-user or non-throwaway deployment, and keep it stable.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_SECRET=your_session_secret_here

# Enable authentication (default: true)
# AUTH_ENABLED=true

# Host bind address and port for the CryoZen web UI.
# Used by Docker Compose and by the native launchers (start-*.sh, launch-windows.ps1).
# Precedence in the launchers: CRYOZEN_HOST/CRYOZEN_PORT > APP_BIND/APP_PORT > default.
# Default host is 127.0.0.1 everywhere; default port is 7000, except the macOS
# native launcher, which uses 7860 because macOS AirPlay usually holds 7000.
# Keep APP_BIND on loopback unless you intentionally want LAN/reverse-proxy access.
# APP_BIND=127.0.0.1
# Change this if another local service already uses 7000 (macOS AirPlay often does).
# APP_PORT=7000

# Development-only auth bypass for loopback requests.
# Keep false for Docker, LAN, reverse proxy, and any shared deployment.
# LOCALHOST_BYPASS=false

# Mark session cookies Secure. Set true when CryoZen is served through HTTPS
# by a trusted reverse proxy or private access gateway.
# SECURE_COOKIES=true

# NOT CURRENTLY HONORED. CRYOZEN_ADMIN_USER and CRYOZEN_ADMIN_PASSWORD are read
# only by create_default_admin() in pratishtha.py, and pratishtha.py:main()
# never calls it: setup writes an empty niti.json and the first admin is created
# through the browser first-run screen instead. docker-compose.yml still
# forwards both variables, so they reach the container and do nothing.
# CRYOZEN_ADMIN_USER=admin
# CRYOZEN_ADMIN_PASSWORD=change_me_before_first_boot

# CORS allowed origins (default: localhost-only; restrict to your public origin in production)
# ALLOWED_ORIGINS=http://localhost:7000,http://localhost:8000

# Per-request wall-clock cap in seconds before the middleware returns 504.
# Streaming, shell, research, model-download, and upload routes are exempt.
# REQUEST_HARD_TIMEOUT=45

# ============================================================
# ChromaDB (vector store)
# ============================================================

# ChromaDB service host.
# Manual host run: localhost:8100 when using `docker run -p 8100:8000 chromadb/chroma`.
# Docker Compose overrides these to chromadb:8000 for in-network access.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Docker Compose host-port bind addresses for bundled services.
# Defaults are loopback-only for safety. To expose ntfy only on Tailscale,
# set NTFY_BIND to your host's Tailscale IP and update NTFY_BASE_URL.
# CHROMADB_BIND=127.0.0.1
# NTFY_BIND=127.0.0.1
# NTFY_BASE_URL=http://localhost:8091
# Example:
# NTFY_BIND=100.x.y.z
# NTFY_BASE_URL=http://100.x.y.z:8091

# ============================================================
# RAG / Embeddings
# ============================================================

# Embedding API endpoint (OpenAI-compatible /v1/embeddings)
# Default: http://{LLM_HOST}:11434/v1/embeddings (ollama)
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Embedding API key (if there's one)
# EMBEDDING_API_KEY=embedding_api_key_here

# Embedding model name (must be available at the endpoint above)
# EMBEDDING_MODEL=all-minilm:l6-v2

# Local fallback embedding model (used when no HTTP embedding API is available)
# Uses fastembed (ONNX) — downloads model on first run (~50MB)
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=  # defaults to ~/.cache/fastembed

# ============================================================
# Misc
# ============================================================

# Cleanup interval in hours (default: 24)
# CLEANUP_INTERVAL_HOURS=24

# In-process email pollers (default: on). Set to 0 if you're driving
# polling from cron / systemd via `cli/cryozen-patra poll-scheduled`
# and `cli/cryozen-patra poll-summary`, otherwise both schedulers
# race on the same SQLite.
# CRYOZEN_INPROCESS_POLLERS=1

# In-process scheduled-task runner (default: on). Set to 0 to let an
# external driver fire scheduled tasks. Calendar reminders are
# frontend-driven (polling /api/notes from the browser) so no gate is
# needed there.
# CRYOZEN_INPROCESS_TASKS=1

# Host used by the built-in "run_script" scheduled-task action.
# Empty/local/localhost runs scripts on the app host. Set to an SSH host alias
# if you intentionally want scheduled scripts to run remotely.
# CRYOZEN_SCRIPT_HOST=localhost

# ============================================================
# Upload and import size limits (bytes)
# ============================================================

# Gallery upload cap (default 104857600 = 100 MB).
# CRYOZEN_GALLERY_UPLOAD_MAX_BYTES=104857600

# Gallery transform-endpoint upload cap (default 26214400 = 25 MB).
# CRYOZEN_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400

# Personal-document upload cap (default 26214400 = 25 MB).
# CRYOZEN_PERSONAL_UPLOAD_MAX_BYTES=26214400

# Memory import file cap (default 10485760 = 10 MB).
# CRYOZEN_MEMORY_IMPORT_MAX_BYTES=10485760

# ============================================================
# Outbound URL safety (SSRF)
# ============================================================
# CryoZen is local-first, so every toggle below is OFF by default and
# private/loopback destinations are reachable out of the box. Non-HTTP(S)
# schemes and the link-local metadata range (169.254.0.0/16) are always
# rejected regardless of these settings.
# Turning a toggle on also blocks private and loopback targets, which stops
# local model servers, local CardDAV, and local image backends from working.
# Do that for internet-exposed or multi-tenant deployments.

# Blocks private/loopback embedding endpoints submitted via /api/embeddings/endpoint.
# EMBEDDING_BLOCK_PRIVATE_IPS=false

# Blocks private/loopback image-generation endpoints.
# IMAGE_BLOCK_PRIVATE_IPS=false

# Blocks private/loopback CardDAV URLs.
# CARDDAV_BLOCK_PRIVATE_IPS=false

# Blocks private/loopback reminder webhook targets.
# REMINDER_WEBHOOK_BLOCK_PRIVATE_IPS=false

# Inverse polarity: CalDAV sync BLOCKS private/loopback by default.
# Set to 1 to allow syncing against a CalDAV server on your LAN or localhost.
# CRYOZEN_ALLOW_PRIVATE_CALDAV=0

# ============================================================
# GPU support (Docker Compose)
# ============================================================
# Pass the host GPU into the cryozen container. Default (unset) = CPU.
# COMPOSE_FILE is a native `docker compose` feature: a colon-separated
# list of files merged left-to-right. Pick ONE GPU line below, or leave
# all commented for CPU.
#
# NVIDIA (requires nvidia-container-toolkit + `nvidia-ctk runtime
# configure --runtime=docker` on the host):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
# COMPOSE_FILE=docker-compose.yml;docker/gpu.nvidia.yml    #(Windows)
#
# AMD ROCm (requires ROCm drivers on the host and the GID of the render group):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml
# Find the render GID with: getent group render | cut -d: -f3
# RENDER_GID=989
#
# These overlays only expose the GPU devices. The slim CryoZen image
# still needs CUDA/ROCm userspace via Shakti -> Dependencies (vLLM,
# llama-cpp-python, etc.) before models can actually serve on GPU.

# ---------------------------------------------------------------------------
# Social sign-in (OAuth) - all optional. Local email/password always works;
# a provider's button only appears once its CLIENT_ID is set. Register your
# own OAuth app per provider and paste the credentials here (self-hosted apps
# use their own OAuth client, which avoids provider verification review).
# Redirect/callback URI to register: {your-base-url}/api/niti/oauth/callback/{provider}
# Docker note: the native launchers read this file directly, but
# docker-compose.yml forwards an explicit list of variables to the cryozen
# container and does not include these, so on the Compose path also add them to
# that service's "environment:" list or they never reach the app.
# ---------------------------------------------------------------------------
# Google (OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft / Entra ID (OpenID Connect). MICROSOFT_TENANT: common (default) |
# organizations | consumers | <tenant-guid>. Must be the tenant GUID, not a
# verified domain like contoso.onmicrosoft.com - real token issuers use the
# GUID form, so domain-name tenants fail issuer validation on every login. Any
# other value logs an error at startup and disables Microsoft sign-in only;
# local login and the other providers are unaffected.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Leave blank to use "common".
MICROSOFT_TENANT=common
# GitHub (OAuth2; GitHub OAuth apps offer no PKCE and no OIDC ID token - the
# flow is protected by the state parameter, and the callback picks a verified
# email via the user:email scope even when the profile email is private).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Facebook Login
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple "Sign in with Apple" - NOT YET SUPPORTED. There is no Apple provider,
# no Apple entry in /api/niti/oauth/providers, and no Apple button on the login
# page, so setting APPLE_* has no effect today. The follow-up change that adds
# the provider will need APPLE_CLIENT_ID (Services ID), APPLE_TEAM_ID,
# APPLE_KEY_ID, and APPLE_PRIVATE_KEY.

# ---------------------------------------------------------------------------
# Linked accounts (Settings -> Account -> Connected Accounts): delegated data
# access that mirrors a user's mail, calendar, tasks, and contacts into local
# storage. Google/Microsoft reuse the same OAuth apps as sign-in above (add
# the extra redirect URI {your-base-url}/api/integrations/accounts/callback/{provider}
# and enable the Gmail / Calendar / Tasks / People APIs, or the Graph
# Mail.Read / Calendars.Read / Tasks.read / Contacts.Read scopes). Apple needs
# no app registration: it links with an iCloud app-specific password
# (https://support.apple.com/102654) because Apple offers no delegated-data
# OAuth - Sign in with Apple is identity-only.
# Background sync interval in minutes (default 15); set ACCOUNT_SYNC_ENABLED=0
# to disable the background loop (manual "Sync now" still works).
ACCOUNT_SYNC_INTERVAL_MIN=15
ACCOUNT_SYNC_ENABLED=1

# ---------------------------------------------------------------------------
# Remote MCP servers (OAuth callback)
# ---------------------------------------------------------------------------
# Origin used to build the MCP OAuth redirect URI
# {base}/api/mcp/oauth/callback, registered with every authorization server via
# Dynamic Client Registration. Default is http://localhost:7000.
# Set this when CryoZen is reachable on a custom port, behind a reverse proxy,
# or on a public domain, otherwise the authorization redirect lands nowhere.
# APP_PORT is deliberately NOT consulted: it only maps the Docker host port,
# while the app always listens on 7000 inside the container.
# OAUTH_REDIRECT_BASE_URL=https://cryozen.example.com

# Checked only when OAUTH_REDIRECT_BASE_URL is unset. Same meaning.
# APP_PUBLIC_URL=https://cryozen.example.com

# Set to 1/true/yes to skip registering every built-in MCP server.
# CRYOZEN_DISABLE_MCP=0

# ---------------------------------------------------------------------------
# Claude and Codex integration bundles
# ---------------------------------------------------------------------------
# Read by integrations/claude/skills/cryozen/scripts/cryozen_api.py and
# integrations/codex/scripts/cryozen_api.py. Both are required: the scripts
# exit with a "missing" message when either is empty. Mint the token under
# Settings -> Agent tokens. Export these in the agent's environment, not
# necessarily in the server's.
# CRYOZEN_URL=http://localhost:7000
# CRYOZEN_API_TOKEN=your_agent_token_here
